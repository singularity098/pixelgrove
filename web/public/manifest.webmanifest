{
  "id": "/",
  "name": "PixelGrove",
  "short_name": "PixelGrove",
  "description": "Your photo and video library",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0f1113",
  "theme_color": "#0f1113",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Timeline", "url": "/timeline", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Map", "url": "/map", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Favorites", "url": "/favorites", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
